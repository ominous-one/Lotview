  "private": true,
  "scripts": {
    "dev:client": "vite dev --port 5000",
    "dev": "cross-env NODE_ENV=development tsx server/index-dev.ts",
    "build": "npx vite build && npx esbuild server/index-prod.ts --platform=node --packages=external --bundle --format=esm --outfile=dist/index.js && npx esbuild server/index-worker.ts --platform=node --packages=external --bundle --format=esm --outfile=dist/index-worker.js && npx esbuild server/scripts/run-daily-scrape.ts --platform=node --packages=external --bundle --format=esm --outfile=dist/scripts/run-daily-scrape.js && npx esbuild server/scripts/run-carfax-refresh.ts --platform=node --packages=external --bundle --format=esm --outfile=dist/scripts/run-carfax-refresh.js",
    "start": "cross-env NODE_ENV=production node dist/index.js",
    "start:worker": "cross-env NODE_ENV=production node dist/index-worker.js",
    "check": "tsc",
    "test:server": "jest --runInBand",
    "test:server:root": "jest --runInBand server/tests/runtime-readiness.test.ts server/tests/vehicle-data-quality.test.ts server/tests/vin-decode-router.test.ts server/tests/robust-scraper-validation.test.ts server/tests/robust-scraper-guardrails.test.ts server/tests/robust-scraper-fallback.test.ts server/tests/workflow-proof-closer-guardrails.test.ts",
    "ci:verify": "npm run check && npm run test:server:root",
    "db:push": "drizzle-kit push",
    "db:migrate": "drizzle-kit migrate",
    "db:seed": "tsx scripts/seed.ts",
    "db:backup": "./scripts/backup.sh",
    "preflight": "tsx scripts/production-preflight.ts",
    "test:smoke": "vitest run --config vitest.smoke.config.ts",
    "lint": "eslint . --ext .ts,.tsx",
    "proof:live-runtime": "node scripts/audit-live-runtime.mjs",
    "proof:dealership-certification": "tsx scripts/run-db-backed-dealership-certification.ts",
    "proof:source-truth-certification": "tsx scripts/materialize-source-truth-certification.ts",
    "proof:live-source-reconciliation": "tsx scripts/generate-live-source-reconciliation.ts",
    "ops:repair-source-truth-inventory": "tsx scripts/repair-source-truth-inventory.ts"
  },
