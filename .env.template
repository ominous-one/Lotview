# ─── Lotview SaaS - Environment Configuration Template ───
# Copy this file to .env and fill in all required values.
# NEVER commit .env to version control.

# ─────────────────────────────────────────────
# REQUIRED: Core Application
# ─────────────────────────────────────────────
NODE_ENV=production
PORT=3000

# JWT_SECRET must be a strong random string (min 32 chars)
# Generate with: openssl rand -hex 32
JWT_SECRET=

# ─────────────────────────────────────────────
# REQUIRED: Database
# ─────────────────────────────────────────────
# Option A: DATABASE_URL (recommended for production)
# Format: postgres://user:password@host:port/database
DATABASE_URL=

# Option B: Individual connection params (fallback)
# PGHOST=localhost
# PGPORT=5432
# PGUSER=lotview
# PGPASSWORD=
# PGDATABASE=lotview

# Connection pool sizing (auto-detected web=50 / worker=20)
# PG_POOL_SIZE=50

# ─────────────────────────────────────────────
# REQUIRED: Redis
# ─────────────────────────────────────────────
# Redis URL for sessions, rate limits, queues, caches
REDIS_URL=redis://localhost:6379

# ─────────────────────────────────────────────
# REQUIRED: GoHighLevel (GHL) CRM Integration
# ─────────────────────────────────────────────
# Get from GHL Marketplace app settings
GHL_CLIENT_ID=
GHL_CLIENT_SECRET=

# GHL API Key for direct API calls (legacy, use OAuth when possible)
GHL_API_KEY=

# ─────────────────────────────────────────────
# REQUIRED: AI / LLM Providers
# ─────────────────────────────────────────────
# OpenAI (for embeddings, chat, content generation)
OPENAI_API_KEY=

# Anthropic Claude (for sales responses, follow-ups)
ANTHROPIC_API_KEY=

# ─────────────────────────────────────────────
# REQUIRED: Facebook Integration
# ─────────────────────────────────────────────
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=

# ─────────────────────────────────────────────
# OPTIONAL: Scraping Infrastructure
# ─────────────────────────────────────────────
# Browserless.io token for cloud browser scraping
BROWSERLESS_TOKEN=

# Apify token for actor-based scraping
APIFY_TOKEN=

# ─────────────────────────────────────────────
# OPTIONAL: Cloud Storage (Vehicle Photos)
# ─────────────────────────────────────────────
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_BUCKET=
# GOOGLE_APPLICATION_CREDENTIALS_JSON={"type":"service_account",...}

# ─────────────────────────────────────────────
# OPTIONAL: Object Storage (Alternative)
# ─────────────────────────────────────────────
# R2 / S3 compatible endpoint
# OBJECT_STORAGE_ENDPOINT=
# OBJECT_STORAGE_BUCKET=
# OBJECT_STORAGE_ACCESS_KEY=
# OBJECT_STORAGE_SECRET_KEY=

# ─────────────────────────────────────────────
# FEATURE FLAGS (Per-Dealership Rollout)
# ─────────────────────────────────────────────
# Enable vehicle deduplication on import
FEATURE_VEHICLE_DEDUP=false

# Enable cloud Carfax scraping via browserless.io
FEATURE_CLOUD_CARFAX=false

# Enable AI-optimized Facebook Marketplace posting
FEATURE_AI_POSTING_OPTIMIZER=false

# Enable GHL SMS fallback when FWC fails
FEATURE_GHL_FALLBACK_SMS=false

# Enable automated appointment reminders
FEATURE_APPOINTMENT_REMINDERS=false

# ─────────────────────────────────────────────
# SCHEDULER CONTROL
# ─────────────────────────────────────────────
# Set to 'false' to disable all background schedulers
LOTVIEW_ENABLE_SCHEDULERS=true

# 'web' = runs on web process, 'worker' = runs on dedicated worker
LOTVIEW_SCHEDULER_PROCESS=web

# ─────────────────────────────────────────────
# LOGGING & OBSERVABILITY
# ─────────────────────────────────────────────
# 'json' for structured logging, 'text' for human-readable
LOG_FORMAT=json

# 'debug' | 'info' | 'warn' | 'error'
LOG_LEVEL=info

# ─────────────────────────────────────────────
# SECURITY
# ─────────────────────────────────────────────
# Comma-separated list of allowed CORS origins
# CORS_ORIGIN=https://app.lotview.ai,https://admin.lotview.ai

# HMAC secret for Chrome extension authentication
EXTENSION_SECRET=

# ─────────────────────────────────────────────
# SYSTEM BASE DOMAIN
# ─────────────────────────────────────────────
# Base domain for dealership subdomains
SYSTEM_BASE_DOMAIN=lotview.ai

# ─────────────────────────────────────────────
# OPTIONAL: Monitoring / Alerting Webhooks
# ─────────────────────────────────────────────
# Slack webhook for system alerts
# ALERT_SLACK_WEBHOOK=

# PagerDuty integration key for critical alerts
# ALERT_PAGERDUTY_KEY=

# ─────────────────────────────────────────────
# DEVELOPMENT ONLY (do not use in production)
# ─────────────────────────────────────────────
# E2E test mode bypass (NEVER in production)
# E2E_TEST_MODE=false
