# ─── Lotview SaaS - Environment Configuration Template ───
# Copy this file to .env and fill in all required values.
# NEVER commit .env to version control.

# ─────────────────────────────────────────────
# REQUIRED: Core Application
# ─────────────────────────────────────────────
NODE_ENV=production
PORT=3000

# Strong random secrets. Generate with: openssl rand -hex 32
JWT_SECRET=
SESSION_SECRET=
ENCRYPTION_KEY=
EXTENSION_HMAC_SECRET=
GHL_WEBHOOK_SECRET=

# Public app/API URLs used by redirects, webhooks, CORS, and health checks.
# Set these to the actual deployed staging or production hosts. Do not use
# unverified example URLs as deployment proof.
APP_URL=
PUBLIC_APP_URL=
PUBLIC_API_URL=

# ─────────────────────────────────────────────
# REQUIRED: Database
# ─────────────────────────────────────────────
# Format: postgres://user:password@host:port/database
DATABASE_URL=

# Connection pool sizing. Render web and worker services may use different values.
# PG_POOL_SIZE=20

# ─────────────────────────────────────────────
# REQUIRED: Redis
# ─────────────────────────────────────────────
# Redis URL for sessions, rate limits, queues, caches
REDIS_URL=redis://localhost:6379

# ─────────────────────────────────────────────
# REQUIRED FOR PRODUCTION CRM: GoHighLevel Integration
# ─────────────────────────────────────────────
GHL_CLIENT_ID=
GHL_CLIENT_SECRET=
GHL_API_KEY=

# ─────────────────────────────────────────────
# REQUIRED FOR AI FEATURES: LLM Providers
# ─────────────────────────────────────────────
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# ─────────────────────────────────────────────
# REQUIRED FOR FACEBOOK FEATURES
# ─────────────────────────────────────────────
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=

# ─────────────────────────────────────────────
# OPTIONAL: Scraping Infrastructure
# ─────────────────────────────────────────────
BROWSERLESS_TOKEN=
BROWSERLESS_API_KEY=
APIFY_TOKEN=

# Optional Scrapling Python sidecar. Keep disabled until staging proof exists.
FEATURE_SCRAPLING_SIDECAR=false
SCRAPLING_PYTHON=python
SCRAPLING_WORKER_PATH=server/sidecars/scrapling_worker.py
SCRAPLING_TIMEOUT_MS=120000
SCRAPLING_MAX_VEHICLES=200

# ─────────────────────────────────────────────
# OPTIONAL: Cloud Storage (Vehicle Photos)
# ─────────────────────────────────────────────
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_BUCKET=
# GOOGLE_APPLICATION_CREDENTIALS_JSON={"type":"service_account",...}

# R2 / S3 compatible endpoint
# OBJECT_STORAGE_ENDPOINT=
# OBJECT_STORAGE_BUCKET=
# OBJECT_STORAGE_ACCESS_KEY=
# OBJECT_STORAGE_SECRET_KEY=

# ─────────────────────────────────────────────
# FEATURE FLAGS (Per-Dealership Rollout)
# ─────────────────────────────────────────────
FEATURE_VEHICLE_DEDUP=false
FEATURE_CLOUD_CARFAX=false
FEATURE_AI_POSTING_OPTIMIZER=false
FEATURE_GHL_FALLBACK_SMS=false
FEATURE_APPOINTMENT_REMINDERS=false

# ─────────────────────────────────────────────
# SCHEDULER CONTROL
# ─────────────────────────────────────────────
# Web should normally be false; worker should normally be true.
LOTVIEW_ENABLE_SCHEDULERS=false
LOTVIEW_SCHEDULER_PROCESS=web

# ─────────────────────────────────────────────
# LOGGING & OBSERVABILITY
# ─────────────────────────────────────────────
LOG_FORMAT=json
LOG_LEVEL=info
SENTRY_DSN=
RELEASE_SHA=

# ─────────────────────────────────────────────
# SECURITY
# ─────────────────────────────────────────────
# Comma-separated list of allowed CORS origins
CORS_ORIGIN=https://lotview.ai,https://app.lotview.ai,https://www.lotview.ai
SYSTEM_BASE_DOMAIN=lotview.ai

# ─────────────────────────────────────────────
# OPTIONAL: Monitoring / Alerting Webhooks
# ─────────────────────────────────────────────
ALERT_SLACK_WEBHOOK=
ALERT_PAGERDUTY_KEY=

# ─────────────────────────────────────────────
# DEVELOPMENT ONLY (do not use in production)
# ─────────────────────────────────────────────
E2E_TEST_MODE=false
