# ============================================================
# Lotview Production Environment Configuration
# ============================================================
# Copy this file to .env and fill in your actual values.
# All feature flags are ENABLED for production.
# ============================================================

# ---- Database ----
DATABASE_URL=postgresql://username:password@host:5432/lotview
# Or use individual vars:
# PGHOST=localhost
# PGPORT=5432
# PGUSER=lotview
# PGPASSWORD=your-password
# PGDATABASE=lotview
PG_POOL_SIZE=50

# ---- Redis (Required for scaling) ----
REDIS_URL=redis://localhost:6379
# REDIS_TLS_URL=rediss://username:password@host:port

# ---- Security (Required in production) ----
JWT_SECRET=change-this-to-a-64-character-random-string-here-now
SESSION_SECRET=change-this-to-a-different-64-character-random-string
EXTENSION_HMAC_SECRET=change-this-to-a-32-character-random-string

# ---- Application ----
NODE_ENV=production
APP_URL=https://lotview.ai
SYSTEM_BASE_DOMAIN=lotview.ai
PORT=3000

# ---- AI Providers ----
ANTHROPIC_API_KEY=your-anthropic-api-key
OPENAI_API_KEY=your-openai-api-key

# ---- Scraping ----
BROWSERLESS_API_KEY=your-browserless-api-key
ZENROWS_API_KEY=your-zenrows-api-key

# ---- Facebook ----
FACEBOOK_APP_ID=your-facebook-app-id
FACEBOOK_APP_SECRET=your-facebook-app-secret

# ---- GoHighLevel ----
GHL_CLIENT_ID=your-ghl-client-id
GHL_CLIENT_SECRET=your-ghl-client-secret
GHL_WEBHOOK_SECRET=your-ghl-webhook-secret


# ============================================================
# FIRST-RUN SETUP — Auto-creates admin, dealership, scraper
# ============================================================
# On first deploy, the app creates these automatically if they don't exist.
# After first run, you can remove the SUPER_ADMIN_PASSWORD for security.

SUPER_ADMIN_EMAIL=rileyabreo@gmail.com
SUPER_ADMIN_PASSWORD=YourSecurePassword123!
SUPER_ADMIN_NAME=Riley Abreo

# Dealership inventory URL (used for first-run auto-scraper setup)
# Change this if your inventory page is at a different path
DEALERSHIP_INVENTORY_URL=https://www.olympichyundaivancouver.com/inventory

# ============================================================
# FEATURE FLAGS — ALL ENABLED FOR PRODUCTION
# ============================================================
ENABLE_AUTOPOST_QUEUE=true
ENABLE_COMPETITIVE_REPORT_SCHEDULER=true
ENABLE_AI_COST_TRACKING=true
ENABLE_SCRAPE_VALIDATION=true
ENABLE_VEHICLE_DEDUPLICATION=true
ENABLE_PHOTO_GUARD=true
ENABLE_WEBHOOK_VERIFICATION=true
ENABLE_GHL_EMAIL_NOTIFICATIONS=true
ENABLE_SCRAPE_FAILURE_ALERTS=true
ENABLE_EXTERNAL_API_RATE_LIMITING=true
ENABLE_FACEBOOK_MESSENGER_API=true
ENABLE_AI_MODEL_ROUTING=true
ENABLE_CALENDAR_SYNC=true
ENABLE_AB_TESTING_FOLLOWUPS=true

# ---- Rate Limiting ----
ENABLE_RATE_LIMITING=true

# ---- Worker Process ----
LOTVIEW_SCHEDULER_PROCESS=web
