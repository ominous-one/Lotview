# ─── Lotview SaaS — Render.com Environment Configuration ───
# Copy this to .env.render and fill in your values.
# Render auto-populates DATABASE_URL and REDIS_URL from the Blueprint.
# You only need to add the integration secrets below.

# ─── Core (Auto-set by Render) ───
NODE_ENV=production
PORT=10000
DATABASE_URL=                    # Render PostgreSQL auto-injects this
REDIS_URL=                       # Render Redis auto-injects this
JWT_SECRET=                      # Generate: openssl rand -hex 32
SESSION_SECRET=                  # Can be same as JWT_SECRET

# ─── GoHighLevel (GHL) CRM ───
GHL_CLIENT_ID=
GHL_CLIENT_SECRET=
GHL_API_KEY=

# ─── AI / LLM ───
OPENAI_API_KEY=                  # sk-... from platform.openai.com
ANTHROPIC_API_KEY=               # sk-ant-... from console.anthropic.com

# ─── Facebook Marketplace ───
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=

# ─── Browserless.io (for scraping) ───
BROWSERLESS_TOKEN=               # Get from browserless.io

# ─── Feature Flags ───
FEATURE_VEHICLE_DEDUP=true
FEATURE_CLOUD_CARFAX=true
FEATURE_AI_POSTING_OPTIMIZER=true
FEATURE_GHL_FALLBACK_SMS=true
FEATURE_APPOINTMENT_REMINDERS=true

# ─── Scheduler ───
LOTVIEW_ENABLE_SCHEDULERS=true
LOTVIEW_SCHEDULER_PROCESS=web    # web for Render web service, worker for worker

# ─── Logging ───
LOG_FORMAT=json
LOG_LEVEL=info

# ─── Security ───
CORS_ORIGIN=https://lotview.ai,https://app.lotview.ai

# ─── Render-specific ───
RENDER=true                      # Signals we're running on Render
